# Local ports and bind hosts
WEB_BIND_HOST=127.0.0.1
WEB_PORT=15173
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=18001
MAIL_BIND_HOST=127.0.0.1
MAIL_PORT=13001

# Frontend build-time backend URLs used by Docker Compose
VITE_BACKEND_URL=http://localhost:18001
VITE_MAIL_SERVER_URL=http://localhost:13001

# CookieCloud auto refresh for Goofish cookies.
# Leave empty to disable automatic cookie renewal. When disabled, expired cookies must be updated manually.
# Fill all three required values, then restart the backend container.
COOKIE_CLOUD_HOST=
COOKIE_CLOUD_UUID=
COOKIE_CLOUD_PASSWORD=
COOKIE_CLOUD_DOMAIN_KEYWORD=goofish.com

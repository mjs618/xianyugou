{
  "name": "xianyu-accounting-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "闲鱼记账与客户管理系统 - 本地优先 Web 应用",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mail-server": "node server/mail-server.mjs",
    "backend": "cd server/backend && uvicorn app.main:app --reload --port 8000",
    "backend:test": "cd server/backend && python test_selfcheck.py"
  },
  "dependencies": {
    "@ant-design/icons": "5.2.6",
    "@types/dompurify": "^3.0.5",
    "antd": "5.13.2",
    "dayjs": "1.11.10",
    "dompurify": "^3.4.12",
    "nodemailer": "^9.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.21.3",
    "reactflow": "11.10.4",
    "recharts": "2.10.4",
    "xlsx": "^0.18.5",
    "zustand": "4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.2.0",
    "@testing-library/react": "14.1.2",
    "@types/node": "14.18.63",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@vitejs/plugin-react": "2.2.0",
    "autoprefixer": "10.4.16",
    "jsdom": "23.2.0",
    "postcss": "8.4.33",
    "tailwindcss": "3.4.1",
    "typescript": "^5.3.3",
    "vite": "3.2.11",
    "vitest": "0.34.6"
  }
}
